HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/forum.sqlite
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
NODE_ENV=development
# Optional private staff webhook; never use a public channel for support notifications.
DISCORD_WEBHOOK_URL=
# Vercel: SQLite-compatible remote database. Keep these values server-side.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Long random value used to authenticate Vercel's retry cron.
CRON_SECRET=
# Optional email provider (Resend API). Without it, reset links are not sent.
RESEND_API_KEY=
MAIL_FROM=
APPEAL_COOLDOWN_HOURS=24
