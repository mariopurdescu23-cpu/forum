{
  "name": "retro-community-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "owner": "node --env-file-if-exists=.env scripts/owner.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "node --check server.mjs && node --check lib/app.mjs && node --check public/app.js && node --check public/theme.js && node --check api/index.mjs && node --check lib/discord.mjs && node --check lib/remote-db.mjs",
    "migrate:remote": "node --env-file-if-exists=.env scripts/migrate-remote.mjs",
    "import:remote": "node --env-file-if-exists=.env scripts/import-remote.mjs",
    "owner:remote": "node --env-file-if-exists=.env scripts/owner-remote.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/functions": "^3.10.1"
  }
}
